# Copy to .env at the repo root - docker compose reads it automatically.
#
#   cp .env.example .env
#
# Every value here has a working default in docker-compose.yml, so the stack
# comes up without this file. You want it for anything beyond a local demo.

# Signing key for the HS256 tokens the gateway validates. Anyone holding this can
# mint a token for any subject with any role, which defeats the entire product.
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=demo-hs256-secret-change-me

# The only access control on /admin/* - metrics, alerts, incidents, entities and
# ownership provisioning all sit behind this single header. Rotate before you
# demo on any network you do not control.
ADMIN_API_KEY=changeme-admin-key

POSTGRES_PASSWORD=neurobots

# Browser origins allowed to call the gateway. "*" is a local-demo convenience.
# CORS is not the security boundary here (X-Admin-Key is), but a wildcard still
# has no business in a real deployment.
CORS_ALLOWED_ORIGINS=*

# Where the DASHBOARD reaches the gateway. This is resolved by the browser, not
# inside the compose network, so it must be a host-reachable address - use the
# machine's LAN IP or hostname if you are demoing from another device.
# Baked into the bundle at build time: change it and rebuild the frontend image.
VITE_GATEWAY_URL=http://127.0.0.1:8080
